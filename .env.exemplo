# Copie para .env e ajuste. Nunca versione o .env.
AGORA_AMBIENTE=demonstracao
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AGORA_SEGREDO_SESSAO=
POSTGRES_PASSWORD=
# true quando houver TLS na frente (obrigatório em produção)
AGORA_COOKIE_SEGURO=false
AGORA_SEED_DEMONSTRACAO=true
AGORA_INTEGRACOES=offline
AGORA_IA_PROVEDOR=nenhum
# AGORA_IA_URL=http://llm.interno.orgao.gov.br:8000
# AGORA_IA_MODELO=modelo-auto-hospedado
# Login Único gov.br (credenciais emitidas pelo gov.br para o órgão)
# AGORA_GOVBR_EMISSOR=https://sso.staging.acesso.gov.br
# AGORA_GOVBR_CLIENT_ID=
# AGORA_GOVBR_CLIENT_SECRET=
# AGORA_GOVBR_REDIRECT=https://agora.orgao.gov.br/api/v1/sessao/govbr/retorno
AGORA_PORTA_PUBLICA=3000
# CNPJ do órgão (necessário para AGORA_INTEGRACOES=online com o PNCP)
# AGORA_ORGAO_CNPJ=
# true atrás de Ingress/proxy reverso
AGORA_CONFIAR_PROXY=false
# Pesquisa de preços (RF-25) e projeção (RIA-11), consultadas só pelo servidor quando AGORA_INTEGRACOES=online
# AGORA_COMPRAS_DADOS_URL=https://dadosabertos.compras.gov.br
# AGORA_TRANSPARENCIA_URL=https://api.portaldatransparencia.gov.br/api-de-dados
# Chave da API do Portal da Transparência (notas fiscais); sem ela, a fonte fica "depende de acesso"
# AGORA_TRANSPARENCIA_CHAVE=
# AGORA_IBGE_SIDRA_URL=https://apisidra.ibge.gov.br
# AGORA_BCB_SGS_URL=https://api.bcb.gov.br/dados/serie
# AGORA_PRECOS_TIMEOUT_MS=15000
# Central de notificações (RF-26): varredura diária e fila no processo da API (api) ou em processo à parte (externo:
# npm run notificacoes -w @agora/api). E-mail simulado até configurar o SMTP do órgão; SEI e gov.br simulados nesta fase.
AGORA_NOTIFICACOES_AGENDADOR=api
AGORA_NOTIFICACOES_EMAIL=simulado
AGORA_NOTIFICACOES_SEI=simulado
AGORA_NOTIFICACOES_GOVBR=simulado
# Servidor SMTP institucional (obrigatório com AGORA_NOTIFICACOES_EMAIL=smtp). Segurança: starttls (587), tls (465) ou nenhuma (25, sem credenciais).
# AGORA_SMTP_HOST=smtp.orgao.gov.br
# AGORA_SMTP_PORTA=587
# AGORA_SMTP_SEGURANCA=starttls
# AGORA_SMTP_USUARIO=
# AGORA_SMTP_SENHA=
# AGORA_SMTP_REMETENTE=nao-responda@orgao.gov.br
# AGORA_SMTP_TIMEOUT_MS=15000
# CEIS e CNEP usam a mesma URL e a mesma chave do Portal da Transparência declaradas acima (AGORA_TRANSPARENCIA_URL e AGORA_TRANSPARENCIA_CHAVE).
# Sem a chave, a consulta falha e a assinatura e a prorrogação ficam bloqueadas (art. 91, § 4º).
# AGORA_TRANSPARENCIA_CACHE_MINUTOS=60
# Documentos do processo (RF-21): limite por arquivo e antivírus do órgão (clamd), opcional
# AGORA_ARQUIVOS_TAMANHO_MAXIMO_MB=20
# AGORA_ANTIVIRUS_URL=tcp://clamav.orgao.gov.br:3310
# Quadro societário (QSA) e cadastro do CNPJ: espelho dos dados abertos da Receita no órgão (só com AGORA_INTEGRACOES=online)
# AGORA_QSA_URL=https://qsa.interno.orgao.gov.br/api
# AGORA_QSA_CHAVE=
