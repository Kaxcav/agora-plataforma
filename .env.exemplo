# Copie para .env e ajuste. Nunca versione o .env.
AGORA_AMBIENTE=demonstracao
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AGORA_SEGREDO_SESSAO=
POSTGRES_PASSWORD=
# true quando houver TLS na frente (obrigatório em produção)
AGORA_COOKIE_SEGURO=false
AGORA_SEED_DEMONSTRACAO=true
AGORA_INTEGRACOES=offline
AGORA_IA_PROVEDOR=nenhum
# AGORA_IA_URL=http://llm.interno.orgao.gov.br:8000
# AGORA_IA_MODELO=modelo-auto-hospedado
# Login Único gov.br (credenciais emitidas pelo gov.br para o órgão)
# AGORA_GOVBR_EMISSOR=https://sso.staging.acesso.gov.br
# AGORA_GOVBR_CLIENT_ID=
# AGORA_GOVBR_CLIENT_SECRET=
# AGORA_GOVBR_REDIRECT=https://agora.orgao.gov.br/api/v1/sessao/govbr/retorno
AGORA_PORTA_PUBLICA=3000
# CNPJ do órgão (necessário para AGORA_INTEGRACOES=online com o PNCP)
# AGORA_ORGAO_CNPJ=
# true atrás de Ingress/proxy reverso
AGORA_CONFIAR_PROXY=false
# Fila de integrações (RabbitMQ do docker-compose). Use só letras e números na senha (ela entra na URL amqp://).
RABBITMQ_PASSWORD=
# Sem AGORA_FILA_URL, a fila é durável no próprio PostgreSQL. AGORA_TRABALHADOR=embutido roda o trabalhador na API.
# AGORA_FILA_URL=amqp://agora:<senha>@fila:5672/agora
# AGORA_TRABALHADOR=separado
# AGORA_FILA_TENTATIVAS=10
# AGORA_FILA_ESPERA_MS=30000
# AGORA_FILA_ESPERA_MAXIMA_MS=3600000
# Publicação no PNCP (login do sistema credenciado; padrão: ambiente de treinamento fora de produção)
# AGORA_PNCP_PUBLICACAO_URL=https://treina.pncp.gov.br/api/pncp
# AGORA_PNCP_USUARIO=
# AGORA_PNCP_SENHA=
