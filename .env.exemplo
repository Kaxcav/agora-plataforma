# Copie para .env e ajuste. Nunca versione o .env.
AGORA_AMBIENTE=demonstracao
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AGORA_SEGREDO_SESSAO=
POSTGRES_PASSWORD=
# true quando houver TLS na frente (obrigatório em produção)
AGORA_COOKIE_SEGURO=false
AGORA_SEED_DEMONSTRACAO=true
AGORA_INTEGRACOES=offline
AGORA_IA_PROVEDOR=nenhum
# AGORA_IA_URL=http://llm.interno.orgao.gov.br:8000
# AGORA_IA_MODELO=modelo-auto-hospedado
# Login Único gov.br (credenciais emitidas pelo gov.br para o órgão)
# AGORA_GOVBR_EMISSOR=https://sso.staging.acesso.gov.br
# AGORA_GOVBR_CLIENT_ID=
# AGORA_GOVBR_CLIENT_SECRET=
# AGORA_GOVBR_REDIRECT=https://agora.orgao.gov.br/api/v1/sessao/govbr/retorno
AGORA_PORTA_PUBLICA=3000
# CNPJ do órgão (necessário para AGORA_INTEGRACOES=online com o PNCP)
# AGORA_ORGAO_CNPJ=
# true atrás de Ingress/proxy reverso
AGORA_CONFIAR_PROXY=false
# Pesquisa de preços (RF-25) e projeção (RIA-11), consultadas só pelo servidor quando AGORA_INTEGRACOES=online
# AGORA_COMPRAS_DADOS_URL=https://dadosabertos.compras.gov.br
# AGORA_TRANSPARENCIA_URL=https://api.portaldatransparencia.gov.br/api-de-dados
# Chave da API do Portal da Transparência (notas fiscais); sem ela, a fonte fica "depende de acesso"
# AGORA_TRANSPARENCIA_CHAVE=
# AGORA_IBGE_SIDRA_URL=https://apisidra.ibge.gov.br
# AGORA_BCB_SGS_URL=https://api.bcb.gov.br/dados/serie
# AGORA_PRECOS_TIMEOUT_MS=15000
# Central de notificações (RF-26): varredura diária e fila no processo da API (api) ou em processo à parte (externo:
# npm run notificacoes -w @agora/api). E-mail simulado até configurar o SMTP do órgão; SEI e gov.br simulados nesta fase.
AGORA_NOTIFICACOES_AGENDADOR=api
AGORA_NOTIFICACOES_EMAIL=simulado
AGORA_NOTIFICACOES_SEI=simulado
AGORA_NOTIFICACOES_GOVBR=simulado
# Servidor SMTP institucional (obrigatório com AGORA_NOTIFICACOES_EMAIL=smtp). Segurança: starttls (587), tls (465) ou nenhuma (25, sem credenciais).
# AGORA_SMTP_HOST=smtp.orgao.gov.br
# AGORA_SMTP_PORTA=587
# AGORA_SMTP_SEGURANCA=starttls
# AGORA_SMTP_USUARIO=
# AGORA_SMTP_SENHA=
# AGORA_SMTP_REMETENTE=nao-responda@orgao.gov.br
# AGORA_SMTP_TIMEOUT_MS=15000
# CEIS e CNEP usam a mesma URL e a mesma chave do Portal da Transparência declaradas acima (AGORA_TRANSPARENCIA_URL e AGORA_TRANSPARENCIA_CHAVE).
# Sem a chave, a consulta falha e a assinatura e a prorrogação ficam bloqueadas (art. 91, § 4º).
# AGORA_TRANSPARENCIA_CACHE_MINUTOS=60
# Documentos do processo (RF-21): limite por arquivo e antivírus do órgão (clamd), opcional
# AGORA_ARQUIVOS_TAMANHO_MAXIMO_MB=20
# AGORA_ANTIVIRUS_URL=tcp://clamav.orgao.gov.br:3310
# Quadro societário (QSA) e cadastro do CNPJ: espelho dos dados abertos da Receita no órgão (só com AGORA_INTEGRACOES=online)
# AGORA_QSA_URL=https://qsa.interno.orgao.gov.br/api
# AGORA_QSA_CHAVE=
# Fila de integrações (RabbitMQ do docker-compose). Use só letras e números na senha (ela entra na URL amqp://).
RABBITMQ_PASSWORD=
# Sem AGORA_FILA_URL, a fila é durável no próprio PostgreSQL. AGORA_TRABALHADOR=embutido roda o trabalhador na API.
# AGORA_FILA_URL=amqp://agora:<senha>@fila:5672/agora
# AGORA_TRABALHADOR=separado
# AGORA_FILA_TENTATIVAS=10
# AGORA_FILA_ESPERA_MS=30000
# AGORA_FILA_ESPERA_MAXIMA_MS=3600000
# Publicação no PNCP (login do sistema credenciado; padrão: ambiente de treinamento fora de produção)
# AGORA_PNCP_PUBLICACAO_URL=https://treina.pncp.gov.br/api/pncp
# AGORA_PNCP_USUARIO=
# AGORA_PNCP_SENHA=
# Planejamento: consulta do PCA publicado (API pública de consulta do PNCP) e validade do cache do catálogo CATMAT/CATSER
# (o catálogo usa AGORA_COMPRAS_DADOS_URL). Só valem com AGORA_INTEGRACOES=online.
# AGORA_PNCP_CONSULTA_URL=https://pncp.gov.br/api/consulta
# AGORA_CATALOGO_CACHE_HORAS=168
# Operação (RNF-10, IMR-01): sonda de disponibilidade (0 = só sob demanda), limites e meta definida pelo órgão.
# AGORA_OPERACAO_SONDA_SEGUNDOS=60
# AGORA_OPERACAO_FILA_ATRASO_MINUTOS=15
# AGORA_OPERACAO_SINCRONIZACAO_ATRASO_HORAS=0
# AGORA_OPERACAO_META_DISPONIBILIDADE=
# Teste de carga (npm run carga -w @agora/api): volumes do ETP do órgão e conta de homologação para --url.
# AGORA_CARGA_CONFIG=deploy/carga/carga.json
# AGORA_CARGA_PROCESSOS_ANO=
# AGORA_CARGA_DOCUMENTOS_ANO=
# AGORA_CARGA_USUARIOS_SIMULTANEOS=
# AGORA_CARGA_EMAIL=
# AGORA_CARGA_SENHA=
# Catálogo de dados abertos (RF-38): downloads por minuto e por IP nas rotas públicas /publico/dados-abertos
# AGORA_DADOS_ABERTOS_LIMITE_MINUTO=60
# Web service do SEI do órgão (RF-35): SeiWS (SOAP). Defina os seis primeiros juntos; os ids vêm do cadastro no SEI.
# Só é usado com AGORA_INTEGRACOES=online; sem ele, o SEI é simulado.
# AGORA_SEI_URL=https://sei.orgao.gov.br/sei/ws/SeiWS.php
# AGORA_SEI_SIGLA_SISTEMA=AGORA
# AGORA_SEI_IDENTIFICACAO_SERVICO=
# AGORA_SEI_ID_UNIDADE=
# AGORA_SEI_ID_TIPO_PROCEDIMENTO=
# AGORA_SEI_ID_SERIE=
# AGORA_SEI_ID_UNIDADE_DESTINO=
# AGORA_SEI_ID_HIPOTESE_LEGAL=
# AGORA_SEI_BLOCO_ASSINATURA=true
# AGORA_SEI_TIMEOUT_MS=60000
# Canal SEI das notificações: webservice inclui o aviso no processo SEI do instrumento (exige AGORA_SEI_*)
# AGORA_NOTIFICACOES_SEI=webservice
# Publicação no DOU (RF-36): consulta pública usada na conferência e horário de fechamento do INCom (Brasília)
# AGORA_DOU_CONSULTA_URL=https://www.in.gov.br/consulta/-/buscar/dou
# AGORA_DOU_HORA_FECHAMENTO=19
# AGORA_DOU_TIMEOUT_MS=20000
# Sigilo (F25): chave do órgão para o cofre de anexos sigilosos (AES-256-GCM, 32 bytes em base64 ou hexadecimal).
# Em produção, sem ela, o cofre fica indisponível. Gere com: openssl rand -base64 32
# AGORA_COFRE_CHAVE=
# Carimbo de tempo da trilha de auditoria (RFC 3161): autoridade do órgão ou credenciada na ICP-Brasil. Sem a URL, a ancoragem é local (modo offline).
# AGORA_CARIMBO_TEMPO_URL=https://carimbo.orgao.gov.br/tsa
# AGORA_CARIMBO_TEMPO_USUARIO=
# AGORA_CARIMBO_TEMPO_SENHA=
# AGORA_CARIMBO_TEMPO_CERTIFICADO_SHA256=
# AGORA_CARIMBO_TEMPO_POLITICA=
# AGORA_CARIMBO_TEMPO_INTERVALO_HORAS=24
# AGORA_CARIMBO_TEMPO_TIMEOUT_SEGUNDOS=15
