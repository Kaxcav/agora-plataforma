{
  "name": "@agora/api",
  "version": "1.0.0",
  "private": true,
  "description": "API e servidor da Ágora (Fastify + PostgreSQL/PGlite).",
  "type": "module",
  "main": "./dist/servidor.js",
  "scripts": {
    "dev": "node --watch src/servidor.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/servidor.js",
    "trabalhador": "node dist/trabalhador.js",
    "dev:trabalhador": "node --watch src/trabalhador.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "seed": "node src/cli/seed.ts",
    "criar-admin": "node src/cli/criar-admin.ts",
    "notificacoes": "node src/cli/notificacoes.ts",
    "carga": "node src/cli/carga.ts"
  },
  "dependencies": {
    "@agora/contratos": "1.0.0",
    "@agora/dominio": "1.0.0",
    "@electric-sql/pglite": "^0.3.16",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "amqplib": "^0.10.9",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/pg": "^8.23.1"
  }
}
